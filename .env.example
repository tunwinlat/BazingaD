# BazingaD environment configuration
# Copy to .env for local development. Environment files are ignored by Git.

# Configure news AI endpoint, API key, and model ID in /admin → Integrations → RSS News & Summarization.
# OpenAI Chat Completions, Anthropic Messages, and MiniMax are supported.
# Provider credentials are stored in SQLite, not environment variables.

# Required: SQLite connection URL
DATABASE_URL="file:./data/dev.db"

# Optional: shared secret protecting POST /api/jobs/news.
# When set, callers must send it in the x-cron-secret header.
# CRON_SECRET="replace-with-a-long-random-secret"
