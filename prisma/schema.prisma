// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  username        String   @unique
  password        String   // Hashed password
  
  // TOTP/2FA fields
  totpSecret      String?  // Base32 encoded TOTP secret
  totpEnabled     Boolean  @default(false)
  totpVerified    Boolean  @default(false) // Has been verified once
  recoveryCode    String?  // Hashed recovery code
  
  // Session management
  passwordChangedAt DateTime @default(now())
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  sessions        Session[]
  
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("sessions")
}

model Settings {
  id                    String   @id @default(cuid())
  
  // General settings
  siteTitle             String   @default("Start Page") // Site title
  favicon               String?  // Base64 encoded favicon SVG or data URL
  theme                 String   @default("default") // Dashboard theme ID
  defaultView           String   @default("comfortable") // Dashboard default view mode
  openInNewTab          Boolean  @default(true) // Whether to open blocks in new tab
  navTransitionEnabled  Boolean  @default(false) // Show transition animation when opening links in same tab
  navTransitionType     String   @default("overlay") // "overlay" or "exit"
  
  // Dashboard protection
  dashboardProtected    Boolean  @default(false)
  dashboardPassword     String?  // Hashed password for dashboard (if different from admin)
  
  // Session settings
  sessionDurationHours  Int      @default(24) // Default 24 hours
  
  // Weather settings
  weatherEnabled        Boolean  @default(false)
  weatherLatitude       Float?   // Location latitude
  weatherLongitude      Float?   // Location longitude
  weatherLocationName   String?  // Display name for the location
  weatherUnits          String   @default("metric") // "metric" or "imperial"
  
  // Traffic settings
  trafficEnabled           Boolean  @default(false)
  trafficApiKey            String?  // Google Routes API key
  trafficTomTomApiKey      String?  // TomTom API key
  trafficPrimaryProvider   String   @default("google") // 'google' or 'tomtom'
  trafficHomeAddress       String?  // Home address
  trafficWorkAddress       String?  // Work address
  trafficTravelMode        String   @default("DRIVE") // DRIVE, BICYCLE, WALK, TWO_WHEELER, TRANSIT
  trafficUnits             String   @default("metric") // metric or imperial

  // News settings
  newsEnabled              Boolean  @default(false)
  newsApiKey               String?  // MiniMax API key
  newsCheckIntervalMinutes Int      @default(60)
  newsUnreadRetentionHours Int      @default(24)
  newsReadRetentionHours   Int      @default(8)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("settings")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String   @default("default")
  sortOrder Int      @default(0)
  disabled  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  blocks    Block[]
  
  @@map("categories")
}

model Block {
  id          String   @id @default(cuid())
  title       String
  url         String
  description String?
  icon        String?
  categoryId  String
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Service monitoring fields
  serviceUrl      String?
  serviceType     String?
  healthCheckUrl  String?
  isMonitored     Boolean  @default(false)
  lastStatus      String?  // "online", "offline", "unknown"
  lastCheckedAt   DateTime?
  
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@map("blocks")
}

model TrafficCache {
  id                    String   @id @default(cuid())

  // Cached route data
  homeToWorkDuration    Int      // Current duration in seconds
  homeToWorkStatic      Int      // Static duration (no traffic) in seconds
  workToHomeDuration    Int      // Current duration in seconds
  workToHomeStatic      Int      // Static duration (no traffic) in seconds

  cachedAt              DateTime @default(now())

  @@map("traffic_cache")
}

model NewsFeed {
  id        String   @id @default(cuid())
  name      String
  url       String
  isDefault Boolean  @default(false)
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles  NewsArticle[]

  @@map("news_feeds")
}

model NewsTopic {
  id        String   @id @default(cuid())
  phrase    String   @unique
  createdAt DateTime @default(now())

  @@map("news_topics")
}

model NewsArticle {
  id           String   @id @default(cuid())
  originalTitle String
  aiTitle      String?
  summary      String?
  url          String
  sourceFeedId String
  publishedAt  DateTime
  fetchedAt    DateTime @default(now())
  isRead       Boolean  @default(false)
  readAt       DateTime?
  expiresAt    DateTime
  contentHash  String   @unique

  sourceFeed NewsFeed @relation(fields: [sourceFeedId], references: [id], onDelete: Cascade)

  @@map("news_articles")
}
